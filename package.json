{
  "name": "vunvault",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,cjs,js,json,md,css,yaml,yml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,cjs,js,json,md,css,yaml,yml}\" --ignore-path .gitignore",
    "prepare": "husky",
    "verify": "node scripts/verify-no-html.mjs && node scripts/verify-forbidden-stack.mjs && node scripts/verify-dockerfiles.mjs && node scripts/verify-terraform.mjs && node scripts/gen-scan-egress.mjs && node scripts/verify-workflows.mjs && node scripts/verify-migrations.mjs && node scripts/verify-env-docs.mjs && node scripts/verify-deploy.mjs",
    "verify:docker": "node scripts/verify-dockerfiles.mjs",
    "verify:terraform": "node scripts/verify-terraform.mjs",
    "verify:workflows": "node scripts/verify-workflows.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:env-docs": "node scripts/verify-env-docs.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@vunvault/config": "workspace:*",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.151.1"
  }
}
