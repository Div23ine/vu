    "@testing-library/user-event": "^14.5.2",
    "husky": "^9.1.4",
    "jsdom": "^24.1.1",
    "lint-staged": "^15.2.9",
    "prettier": "catalog:",
    "turbo": "^2.5.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
