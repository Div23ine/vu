# Code ownership (Task 101). Placeholders until the org teams exist — the
# point of the split is that security-critical paths need a second pair of
# eyes from the security team, and platform plumbing from the platform team.

# Infrastructure and CI are platform-owned.
/infra/                 @vunvault/platform
/.github/               @vunvault/platform
/packages/db/           @vunvault/platform
/docker/                @vunvault/platform
/docker-bake.hcl        @vunvault/platform
/scripts/               @vunvault/platform

# The scan estate, the audit chain and the API's security plugins are
# security-owned: these are the files where a regression is an incident.
/apps/scan-worker/      @vunvault/security
/apps/api/src/audit/    @vunvault/security
/apps/api/src/plugins/  @vunvault/security
/apps/edge/             @vunvault/security
