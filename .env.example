# Names only. Production secrets are loaded from OCI Vault at runtime. Never commit values.
# web (public)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SENTRY_DSN=
# api
DATABASE_URL=            # Supavisor transaction pooler, port 6543
DIRECT_URL=              # direct connection, port 5432, migrations only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
UPSTASH_REDIS_URL=
# Redis optionality (config, NOT a secret). auto = optional outside production,
# required in production · always = optional everywhere (in-memory store, SINGLE
# INSTANCE ONLY) · never = required everywhere (unreachable Redis = FATAL boot
# failure). Re-enabling Redis needs no code change: set UPSTASH_REDIS_URL, restart,
# confirm GET /health reports { redis: "up", store: "redis" }.
REDIS_OPTIONAL=auto
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AUDIT_HMAC_KEY_ID=
AUDIT_HMAC_KEY=
AUDIT_AES_KEY=
NVD_API_KEY=
SENTRY_DSN=
SCAN_CONTROLLER_HMAC_KEY=
SCAN_CONTROLLER_CIDRS=

# FX quotes
FX_API_URL=
FX_QUOTE_TTL_SECONDS=

# Origin lock (edge worker to API): "true" enforces the shared-secret check
ORIGIN_VERIFY_ENFORCE=

# Turnstile captcha: "true" enforces human verification on the public contact
# form and on magic-link requests past the per-IP soft limit (the secret is
# the vault's TURNSTILE_SECRET_KEY, never process env)
TURNSTILE_ENFORCE=

# Web (Next.js) public variables — inlined at build time
NEXT_PUBLIC_R2_HOST=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_BUILD_LABEL=
NEXT_PUBLIC_NODE_LABEL=
# Zura's optional LLM endpoint; absent = Zura answers from the on-device knowledge base only
NEXT_PUBLIC_ZURA_LLM_URL=
# Cloudflare Turnstile site key (public by design) — needed when TURNSTILE_ENFORCE=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# SMS sender (Twilio verified number or messaging service)
TWILIO_FROM=

# Worker tuning (all optional — sensible defaults in code)
BROADCAST_CONCURRENCY=
NOTIFY_CONCURRENCY=
MAINTENANCE_CONCURRENCY=
PDF_CONCURRENCY=
PROGRESS_THROTTLE_MS=
COUNTER_FLUSH_EVERY=
OUTBOX_STUCK_MINUTES=
HEARTBEAT_MISS_LIMIT=
HEARTBEAT_STALE_MS=
DORMANT_AFTER_DAYS=
SIGNUP_STALE_DAYS=
INVITATION_GRACE_HOURS=
LOGIN_ATTEMPT_RETENTION_DAYS=
AUDIT_ALERT_EMAIL=
