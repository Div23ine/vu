{
  // vv-edge (Task 99) — the API reverse proxy in front of api.<zone>.
  //
  // EDGE_ORIGIN_SECRET is a Worker SECRET: `wrangler secret put
  // EDGE_ORIGIN_SECRET --env <env>` from CI, sourced from OCI Vault. It is
  // NEVER written into this file — a committed edge secret would let anyone
  // talk to the origin directly and pick their own cf-connecting-ip.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vv-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": [],
  "analytics_engine_datasets": [
    {
      "binding": "VV_REQUESTS",
      "dataset": "vv_requests", // the maintenance worker's rollup reads this (Task 91)
    },
  ],
  "vars": {
    // DNS-only (grey-cloud) record pointing at the OKE load balancer — the
    // proxied api.<zone> hostname routes HERE, so the origin needs its own name.
    "ORIGIN_HOST": "origin.vunvault.example",
  },
  "env": {
    "staging": {
      "vars": { "ORIGIN_HOST": "origin.staging.vunvault.example" },
      "routes": [{ "pattern": "api.staging.vunvault.example", "custom_domain": true }],
    },
    "production": {
      "vars": { "ORIGIN_HOST": "origin.vunvault.example" },
      "routes": [{ "pattern": "api.vunvault.example", "custom_domain": true }],
    },
  },
}
