{
  "name": "uamp-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3010",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:deploy:production": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vunvault/contracts": "workspace:*",
    "@vunvault/lib": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vunvault/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "6.0.3",
    "wrangler": "^4.158.0"
  }
}