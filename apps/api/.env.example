# Names only. Production secrets are loaded from OCI Vault at runtime. Never commit values.
# api — runtime configuration
NODE_ENV=                # development | test | production
PORT=                    # default 8080
LOG_LEVEL=               # fatal | error | warn | info | debug | trace
WEB_ORIGIN=              # exact web origin, e.g. https://www.vunvault.com
COOKIE_DOMAIN=           # e.g. .vunvault.com (empty in development)
API_PUBLIC_URL=          # public base URL of this API, used as the OpenAPI server
SECRETS_PROVIDER=        # env | oci-vault (production MUST be oci-vault)
OCI_SECRET_MAP=          # JSON map of secret name -> OCI Vault OCID
# api — dependencies and secrets
DATABASE_URL=            # Supavisor transaction pooler, port 6543
DIRECT_URL=              # direct connection, port 5432, migrations only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
UPSTASH_REDIS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AUDIT_HMAC_KEY_ID=
AUDIT_HMAC_KEY=
SENTRY_DSN=

# --- Task 40 closeout: names only, values live in OCI Vault in production ---
# Cloudflare Turnstile (public contact form bot check; TURNSTILE_ENFORCE=true to require it)
TURNSTILE_SECRET_KEY=
# Where contact-form messages are delivered
ENGAGEMENT_INBOX=
SUPPORT_INBOX=
# Who a SEV-1 advisory broadcast pages
INCIDENT_COMMANDER_ID=
# Scan fleet capacity for the Command Center gauge
WORKER_SLOTS_TOTAL=
# Label printed on the audit chain panel
NODE_LABEL=
# WebAuthn relying party
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
# Cloudflare R2 object storage
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# FX rate feed for display-only quotes (charges are always USD)
FX_API_URL=
FX_QUOTE_TTL_SECONDS=
# Policy version stamped on consent records
TERMS_VERSION=

# broadcast-worker (Task 89) — names only, values live in OCI Vault in production
# REDIS_URL=             # BullMQ broadcast queue + broadcast:progress:* pub/sub
# DATABASE_URL=          # Supavisor pooler; audience reads and counter writes
# RESEND_API_KEY=
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# BROADCAST_CONCURRENCY= # default 2
# PROGRESS_THROTTLE_MS=  # default 2000
# COUNTER_FLUSH_EVERY=   # default 25

# notify-worker (Task 90) — names only, values live in OCI Vault in production
# REDIS_URL=             # BullMQ notify + pdf queues
# DATABASE_URL=          # inbox + receipt writes, invoice/report reads
# RESEND_API_KEY=
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# R2_ACCOUNT_ID=         # rendered invoice/report PDF uploads
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=
# WEB_ORIGIN=            # absolute links inside transactional e-mail
# NOTIFY_CONCURRENCY=    # default 8
# PDF_CONCURRENCY=       # default 2

# api — edge origin lock (Task 99)
# EDGE_ORIGIN_SECRET=    # shared with the vv-edge Worker (wrangler secret); Vault in production
# ORIGIN_VERIFY_ENFORCE= # 'false' disables the x-origin-verify requirement (escape hatch only)

# maintenance-worker (Tasks 91–92) — names only, values live in OCI Vault in production
# REDIS_URL=             # BullMQ maintenance queue + the repeatable scheduler
# DATABASE_URL=          # sweep reads/writes
# MAINTENANCE_CONCURRENCY=  # default 2
# HEARTBEAT_STALE_MS=    # default 90000 (3 × the API's 30 s heartbeat skew)
# HEARTBEAT_MISS_LIMIT=  # default 3 consecutive misses → offline
# LOGIN_ATTEMPT_RETENTION_DAYS= # default 30
# INVITATION_GRACE_HOURS=# default 0
# DORMANT_AFTER_DAYS=    # default 90
# SIGNUP_STALE_DAYS=     # default 7
# OUTBOX_STUCK_MINUTES=  # default 2
# R2_ACCOUNT_ID=         # daily audit snapshot
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=    # media_scan allow-list origin
# AUDIT_HMAC_KEY_ID=     # chain VERIFICATION only — appends stay in the API
# AUDIT_HMAC_KEY=
# AUDIT_ALERT_EMAIL=     # optional; a chain mismatch e-mails this address
