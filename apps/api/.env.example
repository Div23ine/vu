# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# BROADCAST_CONCURRENCY= # default 2
# PROGRESS_THROTTLE_MS=  # default 2000
# COUNTER_FLUSH_EVERY=   # default 25

# notify-worker (Task 90) — names only, values live in OCI Vault in production
# REDIS_URL=             # BullMQ notify + pdf queues
# DATABASE_URL=          # inbox + receipt writes, invoice/report reads
# RESEND_API_KEY=
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# R2_ACCOUNT_ID=         # rendered invoice/report PDF uploads
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=
# WEB_ORIGIN=            # absolute links inside transactional e-mail
# NOTIFY_CONCURRENCY=    # default 8
# PDF_CONCURRENCY=       # default 2

# api — edge origin lock (Task 99)
# EDGE_ORIGIN_SECRET=    # shared with the vv-edge Worker (wrangler secret); Vault in production
# ORIGIN_VERIFY_ENFORCE= # 'false' disables the x-origin-verify requirement (escape hatch only)

# maintenance-worker (Tasks 91–92) — names only, values live in OCI Vault in production
# REDIS_URL=             # BullMQ maintenance queue + the repeatable scheduler
# DATABASE_URL=          # sweep reads/writes
# MAINTENANCE_CONCURRENCY=  # default 2
# HEARTBEAT_STALE_MS=    # default 90000 (3 × the API's 30 s heartbeat skew)
# HEARTBEAT_MISS_LIMIT=  # default 3 consecutive misses → offline
# LOGIN_ATTEMPT_RETENTION_DAYS= # default 30
# INVITATION_GRACE_HOURS=# default 0
# DORMANT_AFTER_DAYS=    # default 90
# SIGNUP_STALE_DAYS=     # default 7
# OUTBOX_STUCK_MINUTES=  # default 2
# R2_ACCOUNT_ID=         # daily audit snapshot
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=    # media_scan allow-list origin
# AUDIT_HMAC_KEY_ID=     # chain VERIFICATION only — appends stay in the API
# AUDIT_HMAC_KEY=
# AUDIT_ALERT_EMAIL=     # optional; a chain mismatch e-mails this address
