# syntax=docker/dockerfile:1
#
# VUNVAULT scan runner image (Task 87).
#
# Multi-stage and hardened. The final stage contains: the Node binary, the
# compiled runner, four pinned scanning tools, and nothing that could be used to
# escalate. It must run under `readOnlyRootFilesystem: true` with
# `capabilities: drop ALL`, which constrains the tools as much as the image:
# nmap is used in connect-scan mode (`-sT`) precisely because a SYN scan needs
# CAP_NET_RAW that the pod will never have.
#
# CHECKSUMS ARE NOT COMMITTED. The `*_SHA256` build args have no defaults on
# purpose, so a build without them FAILS rather than silently fetching whatever
# is currently at a URL. CI supplies them from the release artefacts; see
# TOOLS.md.

# ——————————————————————————————————————————— build: compile the runner
FROM node:22-bookworm-slim AS build
ARG PNPM_VERSION=9.15.0
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/contracts ./packages/contracts
COPY packages/db ./packages/db
COPY apps/scan-worker ./apps/scan-worker
RUN pnpm install --frozen-lockfile --filter scan-worker...
RUN pnpm --filter scan-worker build:runner
# Prune to production-only dependencies for the copy into the final stage.
RUN pnpm --filter scan-worker prune --prod || true

# ——————————————————————————————————————————— tools: fetch and verify
FROM debian:13-slim AS tools
ARG NMAP_VERSION
ARG NUCLEI_VERSION
ARG NUCLEI_SHA256
ARG HTTPX_VERSION
ARG HTTPX_SHA256
ARG TESTSSL_VERSION
ARG TESTSSL_SHA256
ARG NUCLEI_TEMPLATES_REF
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /tools

# nmap comes from Debian so its libraries are satisfied by apt; the version is
# pinned through the build arg.
ARG NMAP_PACKAGE
RUN apt-get update \
 && apt-get install -y --no-install-recommends --allow-downgrades ${NMAP_PACKAGE:?NMAP_PACKAGE build arg is required} \
 && rm -rf /var/lib/apt/lists/*

# nuclei and httpx: download, verify the checksum, and fail the build on a
# mismatch. An unverified binary is how a supply-chain compromise reaches a pod
# that scans customer infrastructure.
RUN set -eux; \
    test -n "${NUCLEI_VERSION:?}"; test -n "${NUCLEI_SHA256:?}"; \
    curl -fsSL -o nuclei.zip \
      "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VERSION}/nuclei_${NUCLEI_VERSION}_linux_amd64.zip"; \
    echo "${NUCLEI_SHA256}  nuclei.zip" | sha256sum -c -; \
    unzip -q nuclei.zip nuclei; rm nuclei.zip; \
    test -n "${HTTPX_VERSION:?}"; test -n "${HTTPX_SHA256:?}"; \
    curl -fsSL -o httpx.zip \
      "https://github.com/projectdiscovery/httpx/releases/download/v${HTTPX_VERSION}/httpx_${HTTPX_VERSION}_linux_amd64.zip"; \
    echo "${HTTPX_SHA256}  httpx.zip" | sha256sum -c -; \
    unzip -q httpx.zip httpx; rm httpx.zip

# testssl.sh at a pinned tag, checksum verified.
RUN set -eux; \
    test -n "${TESTSSL_VERSION:?}"; test -n "${TESTSSL_SHA256:?}"; \
    curl -fsSL -o testssl.tar.gz \
      "https://github.com/drwetter/testssl.sh/archive/refs/tags/${TESTSSL_VERSION}.tar.gz"; \
    echo "${TESTSSL_SHA256}  testssl.tar.gz" | sha256sum -c -; \
    mkdir -p /tools/testssl; tar -xzf testssl.tar.gz -C /tools/testssl --strip-components=1; \
    rm testssl.tar.gz

# Templates are baked in at BUILD time from a pinned ref. The runner passes
# `-no-update-templates`, so nothing is fetched at runtime.
RUN set -eux; \
    test -n "${NUCLEI_TEMPLATES_REF:?}"; \
    apt-get update && apt-get install -y --no-install-recommends git; \
    git clone --depth 1 --branch "${NUCLEI_TEMPLATES_REF}" \
      https://github.com/projectdiscovery/nuclei-templates.git /tools/nuclei-templates; \
    rm -rf /tools/nuclei-templates/.git; \
    apt-get purge -y git; apt-get autoremove -y; rm -rf /var/lib/apt/lists/*

# ——————————————————————————————————————————— final: nothing but what is needed
FROM debian:13-slim AS final
ARG BUILD_DATE
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.title="vunvault-scan-runner" \
      org.opencontainers.image.source="https://github.com/Div23ine/vu" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.description="Unprivileged VUNVAULT scan runner"

COPY --from=build /usr/local/bin/node /usr/local/bin/node
COPY --from=build /workspace/apps/scan-worker/runner/dist /app/dist
COPY --from=build /workspace/apps/scan-worker/node_modules /app/node_modules
COPY --from=tools /usr/bin/nmap /usr/bin/nmap
COPY --from=tools /usr/lib/x86_64-linux-gnu /usr/lib/x86_64-linux-gnu
COPY --from=tools /tools/nuclei /usr/local/bin/nuclei
COPY --from=tools /tools/httpx /usr/local/bin/httpx
COPY --from=tools /tools/testssl /opt/testssl
COPY --from=tools /tools/nuclei-templates /opt/nuclei-templates

# Strip everything that is not needed to run a scan: package managers, apt lists
# and every shell except the one testssl.sh requires.
RUN set -eux; \
    apt-get purge -y --auto-remove -o APT::AutoRemove::RecommendsImportant=false; \
    rm -rf /var/lib/apt/lists /var/cache/apt /etc/apt; \
    rm -f /usr/bin/apt /usr/bin/apt-get /usr/bin/dpkg /usr/bin/dpkg-deb; \
    rm -f /bin/bash /usr/bin/bash /bin/dash /usr/bin/dash /bin/zsh; \
    ln -sf /opt/testssl/testssl.sh /usr/local/bin/testssl.sh; \
    chmod 0755 /usr/local/bin/nuclei /usr/local/bin/httpx /opt/testssl/testssl.sh; \
    # No setuid/setgid binary may survive: with all capabilities dropped they
    # would be the only remaining escalation path.
    find / -xdev -perm /6000 -type f -delete; \
    # 65532 is the nonroot user the pod runs as (Task 86's manifest).
    mkdir -p /tmp && chmod 1777 /tmp

# Defence in depth: the pod's securityContext already sets runAsUser/runAsGroup
# 65532, but the image itself must not default to root either — a manifest that
# forgot the context should still not get a root shell. There is deliberately no
# matching entry in /etc/passwd, so nothing in the image resolves to a
# privileged account.
USER 65532:65532
ENV NODE_ENV=production
WORKDIR /tmp
# No EXPOSE: a scan pod is a client, never a server.
ENTRYPOINT ["/usr/local/bin/node", "/app/dist/main.js"]
