{
  "name": "scan-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p runner/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "build:runner": "tsc -p runner/tsconfig.json --outDir runner/dist"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "@vunvault/contracts": "workspace:*",
    "bullmq": "^5.81.5",
    "fast-xml-parser": "^4.5.7",
    "ioredis": "^5.11.1",
    "pino": "^9.14.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vunvault/config": "workspace:*",
    "eslint": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
