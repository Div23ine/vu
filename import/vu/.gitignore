# dependencies
node_modules

# builds / framework output
.next
# `@opennextjs/cloudflare` output: the Worker (.open-next/worker.js) and the
# static half (.open-next/assets). Replaced `.vercel/output` from next-on-pages.
.open-next
# generated by `next dev` / `next build`; it is a build artefact, not source
next-env.d.ts
# generated by `pnpm --filter web cf:typegen` (wrangler types)
cloudflare-env.d.ts
# wrangler's local state (dry-run/dev tmp) for the web and edge Workers
.wrangler
# generated by `msw init` (operator pre-step after Task 42); msw says "do NOT modify",
# so it is neither committed nor formatted — regenerate per environment
mockServiceWorker.js
.turbo
dist
coverage
*.tsbuildinfo

# environment
.env
.env.*
!.env.example
# wrangler's local-only secrets/vars file (Workers equivalent of .env)
.dev.vars
!.dev.vars.example

# logs
*.log

# os
.DS_Store

# testing
playwright-report
test-results

# infra
.terraform
*.tfstate
*.tfstate.*
*.tfvars

# terraform (Task 98) — state and variable values never live in git;
# .terraform.lock.hcl IS committed (provider pinning).
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!example.tfvars
crash.log
crash.*.log
apps/web/core
