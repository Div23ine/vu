# Public build-time configuration for apps/web.
#
# Every name here is prefixed NEXT_PUBLIC_, which means Next inlines it into the
# client bundle. Nothing secret belongs in this file or in any variable that starts
# with that prefix: a browser can read all of it. Secrets live in the API's OCI Vault.
#
# Names only — values are set per environment in the BUILDING SHELL (CI passes
# them from GitHub repository variables). Next inlines them at build time, so a
# value changed after the build has no effect until the next build.

# Origin of the Fastify API, e.g. https://api.vunvault.com
NEXT_PUBLIC_API_URL=http://localhost:8080
# Canonical origin of this site, used for metadataBase and Open Graph URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# MSW mock layer (Task 42): `enabled` serves every API call from local fixtures
# instead of the real API. This is a LOCAL-DEV convenience only.
#
#   ⚠ A production build REFUSES to run while this is `enabled`: `next.config.ts`
#   throws "Refusing to build with the MSW mock layer enabled." Before any
#   `cf:build` / `next build`, set it to `disabled` (or delete the line) in your
#   gitignored apps/web/.env.local — a shell `unset` will NOT work, because Next
#   loads .env* files into process.env before next.config.ts runs.
#
#   Valid values: `enabled`, `disabled`, empty, or absent (any typo throws).
NEXT_PUBLIC_API_MOCKING=enabled
