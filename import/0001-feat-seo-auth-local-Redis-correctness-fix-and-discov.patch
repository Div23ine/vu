+      expect(warnings.some((entry) => /FAILING OPEN/.test(entry.message))).toBe(true);
+      expect(warnings[0]?.fields.scope).toBe('magic_link_email_window');
+    });
+
+    it('fails CLOSED on the single-use token store, and names Redis not Resend', async () => {
+      const store = flakyStore(connection as unknown as KvStore);
+      const { warnings, log } = recordingLogger();
+      const tokens = new MagicLinkTokenStore(
+        store,
+        deriveMagicLinkSecret('live-secret'),
+        undefined,
+        undefined,
+        log,
+      );
+
+      store.fail = true;
+      // Issuing must refuse: a token that was never stored cannot be validated
+      // later, and pretending otherwise would send a link that cannot work.
+      await expect(tokens.issue('closed@example.test')).rejects.toThrow(/simulated redis fault/);
+
+      const warning = warnings.at(-1);
+      expect(warning?.message).toMatch(/fail closed/i);
+      expect(warning?.message).toMatch(/NOT a Resend failure/);
+      expect(warning?.fields.scope).toBe('magic_link_issue');
+    });
+
+    it('fails CLOSED on the invite cooldown, suppressing the send rather than bombing', async () => {
+      const store = flakyStore(connection as unknown as KvStore);
+      const { warnings, log } = recordingLogger();
+      const invites = new SignupInviteCooldown(store, undefined, log);
+
+      store.fail = true;
+      expect(await invites.claim('bomb@example.test')).toBe(false);
+      expect(warnings.some((entry) => /FAILING CLOSED/.test(entry.message))).toBe(true);
+    });
+  });
+});
diff --git a/apps/api/src/plugins/redis.ts b/apps/api/src/plugins/redis.ts
index 0456b0d..5c26317 100644
--- a/apps/api/src/plugins/redis.ts
+++ b/apps/api/src/plugins/redis.ts
@@ -99,14 +99,27 @@ async function withTimeout<T>(work: Promise<T>, ms: number, label: string): Prom
 /**
  * Prove a server is really there before trusting it.
  *
- * A separate, non-retrying probe connection is used so an unreachable host fails
- * in bounded time instead of leaving the command connection retrying forever in
- * the background. `connect` is called only when it exists — the unit-test fake
- * implements `ping` alone.
+ * The connection we intend to KEEP is probed (not a throwaway), so an online boot
+ * opens exactly the one connection it always did and an offline boot opens no
+ * socket that has to be torn down.
+ *
+ * `connect()` is valid only from ioredis's `wait` status. ioredis auto-connects
+ * in its constructor (`lazyConnect` defaults to false) and queues commands issued
+ * while connecting, so `ping()` alone proves the server. Calling `connect()` on an
+ * already-connecting instance makes ioredis reject with
+ * `Redis is already connecting/connected` — which failed this probe against a
+ * perfectly healthy server, silently dropping the API to memory mode (and, in
+ * production where Redis is required, refusing to boot). Found by running the
+ * plugin against a real `redis-server` rather than the unit-test fake, which
+ * implements `ping` alone and so could not exercise the path.
  */
 async function probeRedis(connection: Redis, ms: number): Promise<void> {
   const connectable = connection as unknown as { connect?: () => Promise<unknown> };
-  const connect = typeof connectable.connect === 'function' ? connectable.connect() : Promise.resolve();
+  const alreadyConnecting = connection.status !== 'wait';
+  const connect =
+    !alreadyConnecting && typeof connectable.connect === 'function'
+      ? connectable.connect()
+      : Promise.resolve();
   await withTimeout(connect.then(() => connection.ping()), ms, 'redis probe');
 }
 
