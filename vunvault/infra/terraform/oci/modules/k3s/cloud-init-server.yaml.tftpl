#cloud-config
# k3s control node (Task 98). The join token arrives here — mode 0600, root
# only — because the alternative (a Kubernetes Secret bootstrap) needs a
# cluster that does not exist yet. State exposure is bounded by the private,
# versioned, CMK-encrypted backend bucket.
write_files:
  - path: /etc/rancher/k3s/token
    permissions: "0600"
    content: |
      ${k3s_token}
  - path: /etc/sysctl.d/99-vv.conf
    permissions: "0644"
    content: |
      net.ipv4.conf.all.rp_filter=1
      net.ipv4.conf.all.accept_redirects=0
      net.ipv4.conf.all.send_redirects=0
      net.ipv6.conf.all.disable_ipv6=1
runcmd:
  # Defence in depth: pod FORWARD traffic may never reach link-local
  # (169.254.169.254 is the metadata service) or private space, even if a
  # network rule were ever loosened above the host.
  - iptables -I FORWARD -d 169.254.0.0/16 -j DROP
  - iptables -I FORWARD -d 10.0.0.0/8 -j DROP
  - iptables -I FORWARD -d 172.16.0.0/12 -j DROP
  - iptables -I FORWARD -d 192.168.0.0/16 -j DROP
  - netfilter-persistent save || true
  - sysctl --system
  - curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" sh -s - server
      --disable traefik --disable servicelb
      --secrets-encryption
      --write-kubeconfig-mode 600
      --node-label vv/pool=control
      --token-file /etc/rancher/k3s/token
