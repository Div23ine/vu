#cloud-config
# k3s scan agent (Task 98): labelled and tainted so ONLY scan pods — which the
# controller already confines with runAsNonRoot, dropped capabilities and a
# read-only rootfs (Task 86) — are ever scheduled here.
write_files:
  - path: /etc/rancher/k3s/token
    permissions: "0600"
    content: |
      ${k3s_token}
runcmd:
  - iptables -I FORWARD -d 169.254.0.0/16 -j DROP
  - iptables -I FORWARD -d 10.0.0.0/8 -j DROP
  - iptables -I FORWARD -d 172.16.0.0/12 -j DROP
  - iptables -I FORWARD -d 192.168.0.0/16 -j DROP
  - netfilter-persistent save || true
  - curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" K3S_URL="https://${server_ip}:6443" sh -s - agent
      --node-label vv/pool=scan
      --node-taint vv/scan=true:NoSchedule
      --token-file /etc/rancher/k3s/token
