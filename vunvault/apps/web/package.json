{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "pages:build": "next-on-pages",
    "pages:deploy:staging": "wrangler pages deploy --project-name vunvault-web-staging --branch staging",
    "pages:deploy:production": "wrangler pages deploy --project-name vunvault-web-production --branch main",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.0.0",
    "@tanstack/react-query": "^5.62.7",
    "@vunvault/contracts": "workspace:*",
    "@vunvault/lib": "workspace:*",
    "@vunvault/ui": "workspace:*",
    "lucide-react": "^0.468.0",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.54.2",
    "zod": "catalog:",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vunvault/config": "workspace:*",
    "eslint": "catalog:",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^3.101.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
