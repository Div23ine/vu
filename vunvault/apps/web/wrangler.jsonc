{
  // VUNVAULT web on Cloudflare Pages (deploy guide: docs/deploy-guide.md).
  //
  // The build is `next-on-pages` (`pnpm --filter web pages:build`), which
  // compiles every non-static route to an edge-compatible Pages Function and
  // writes the deployable to `.vercel/output/` — `pages_build_output_dir`
  // below points `wrangler pages deploy` at its static half (the functions
  // half is picked up automatically from the sibling directory).
  //
  // TWO rules this file exists to enforce:
  //
  //  1. `nodejs_compat` is REQUIRED by next-on-pages — without the flag the
  //     deployed Functions die at runtime, not at build time.
  //  2. The default project is STAGING. Production deploys must pass
  //     `--project-name vunvault-web-production` explicitly (the
  //     `pages:deploy:production` script does), so an absent-minded
  //     `wrangler pages deploy` can never touch production.
  //
  // NEXT_PUBLIC_* variables are BUILD-TIME: Next inlines them into the client
  // bundle during `pages:build`, so they come from the building shell (or the
  // Pages dashboard's per-environment build variables) — putting them here
  // would do nothing. The web app needs no runtime secrets: every API call
  // goes from the browser straight to the vv-edge Worker with cookies.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vunvault-web-staging",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".vercel/output/static",
  "observability": {
    "enabled": true,
  },
}
