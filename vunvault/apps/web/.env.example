# Public build-time configuration for apps/web.
#
# Every name here is prefixed NEXT_PUBLIC_, which means Next inlines it into the
# client bundle. Nothing secret belongs in this file or in any variable that starts
# with that prefix: a browser can read all of it. Secrets live in the API's OCI Vault.
#
# Names only — values are set per environment in CI / Cloudflare Pages.

# Origin of the Fastify API, e.g. https://api.vunvault.com
NEXT_PUBLIC_API_URL=
# Canonical origin of this site, used for metadataBase and Open Graph URLs
NEXT_PUBLIC_SITE_URL=
# Optional browser-side error reporting
NEXT_PUBLIC_SENTRY_DSN=
# Set to `enabled` to serve the MSW mock layer (Task 42) instead of the real API
NEXT_PUBLIC_API_MOCKING=
# Host the CDN serves uploaded and generated images from
NEXT_PUBLIC_R2_HOST=
# Human-readable build label shown in the admin footer
NEXT_PUBLIC_BUILD_LABEL=
# Sensor/verifying node label shown on the audit chain panel
NEXT_PUBLIC_NODE_LABEL=
# Stripe publishable key — browser-side card tokenisation (Task 66). Publishable
# by design; raw card data never reaches VUNVAULT.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
