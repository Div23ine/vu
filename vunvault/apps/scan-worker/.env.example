# Scan controller — environment variable NAMES only.
# Values come from Vault (production) or a local .env (development).
# The controller holds NO database credentials by design: its only secret is the
# HMAC key that signs its callbacks to the API.

NODE_ENV=
LOG_LEVEL=

# Redis: BullMQ queue, scan:ctl:* pub/sub and the worker-slot semaphore.
REDIS_URL=

# Base URL of the API's internal routes (no trailing slash).
API_INTERNAL_URL=

# Shared with the API. The signature IS the controller's identity.
SCAN_CONTROLLER_HMAC_KEY=

# Worker slots = BullMQ concurrency = the semaphore ceiling.
WORKER_SLOTS_TOTAL=

# Prefix for every Redis key this controller owns.
REDIS_KEY_PREFIX=

# Per-request timeout for a signed callback, in milliseconds.
API_TIMEOUT_MS=

# --- Task 86 (Kubernetes pod execution) ---
# The controller runs IN the cluster (loadFromCluster); the namespace is a
# chart value, not an env knob. Only the runner image is read here.
RUNNER_IMAGE=
