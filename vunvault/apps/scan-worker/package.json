{
  "name": "scan-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p runner/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "build:runner": "tsc -p runner/tsconfig.json --outDir runner/dist"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.0.0",
    "@vunvault/contracts": "workspace:*",
    "bullmq": "^5.34.8",
    "fast-xml-parser": "^4.5.0",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vunvault/config": "workspace:*",
    "eslint": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
